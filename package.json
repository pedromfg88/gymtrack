{
  "name": "gymtrack-apk",
  "version": "1.0.0",
  "private": true,
  "description": "GymTrack — registo de treino (APK Capacitor + PWA para iPhone; dados em CSV no Google Drive)",
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "0.383.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:pwa": "node scripts/build-web.mjs --pwa",
    "test": "node test/store.test.mjs && node test/web.test.mjs",
    "android:add": "cap add android",
    "android:patch": "node scripts/patch-android.mjs",
    "android:sync": "cap sync android",
    "android:prepare": "npm run build:web && (test -d android || npm run android:add) && npm run android:patch && npm run android:sync"
  }
}
